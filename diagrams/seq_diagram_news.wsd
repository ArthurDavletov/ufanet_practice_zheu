@startuml "Диаграмма последовательности для новостей"
actor "Житель" as Resident
actor "Администратор" as Admin
participant "NewsService" as News
participant "AuthService" as Auth
participant "NotificationService" as Notify

== Просмотр новостей ==

Resident -> News : Получить новости
activate News

News --> Resident : Список новостей

deactivate News

== Создание новости ==

Admin -> News : Создать новость
activate News

News -> Auth : Проверить сессию\nи права администратора
activate Auth
Auth --> News : Права подтверждены
deactivate Auth

News -> News : Сохранить новость

News -> Notify : Отправить уведомление\nо новой новости
activate Notify
Notify --> Resident : Уведомление о новой новости
deactivate Notify

News --> Admin : Новость создана
deactivate News

@enduml
